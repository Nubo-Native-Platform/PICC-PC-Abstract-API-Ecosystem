<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <!-- GitHub Packages Authentication (Populated via environment variables or CI secrets) -->
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <!-- GitLab Maven Registry Authentication (Optional) -->
        <server>
            <id>gitlab-maven</id>
            <username>${env.CI_REGISTRY_USER}</username>
            <password>${env.CI_JOB_TOKEN}</password>
        </server>
        <!-- OSSRH / Sonatype Central Authentication (Optional) -->
        <server>
            <id>ossrh</id>
            <username>${env.OSSRH_USERNAME}</username>
            <password>${env.OSSRH_PASSWORD}</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>default</id>
            <repositories>
                <!-- Public Maven Repository for NNP Platform Parent Artifacts -->
                <repository>
                    <id>nnp-public-abstract-platform</id>
                    <name>NNP Public Maven Repository - Abstract Platform</name>
                    <url>https://nubo-native-platform.github.io/PICC-PC-Abstract-NNP-Platform/maven/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>default</activeProfile>
    </activeProfiles>
</settings>
